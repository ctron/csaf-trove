[server]
listen = "{{ csaf_trove_listen }}"
api_token_file = "{{ csaf_trove_api_token_file }}"

[data]
dir = "{{ csaf_trove_data_dir }}"

[github]
repo = "{{ csaf_trove_github_source_repo }}"
webhook_secret_file = "{{ csaf_trove_webhook_secret_file }}"
poll_interval = "{{ csaf_trove_poll_interval }}"

[scheduler]
sync_interval = "{{ csaf_trove_sync_interval }}"
max_concurrent = {{ csaf_trove_max_concurrent }}

[cache]
cve_search_capacity = {{ csaf_trove_cve_cache_capacity }}
cve_search_ttl = "{{ csaf_trove_cve_cache_ttl }}"
cve_search_max_hits = {{ csaf_trove_cve_cache_max_hits }}

[mcp]
enabled = {{ csaf_trove_mcp_enabled | bool | lower }}
allowed_hosts = {{ csaf_trove_mcp_allowed_hosts | to_json }}

[rate_limit]
enabled = {{ csaf_trove_rate_limit_enabled | bool | lower }}
requests_per_minute = {{ csaf_trove_rate_limit_requests_per_minute }}
burst = {{ csaf_trove_rate_limit_burst }}
max_wait = "{{ csaf_trove_rate_limit_max_wait }}"
